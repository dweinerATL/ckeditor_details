<?php

/**
 * @file
 * Hook implementations for the CKeditor Details Accordion module.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;

/**
 * Implements hook_help().
 */
function ckeditor_details_help(string $route_name, RouteMatchInterface $route_match) : ?string {
  switch ($route_name) {
    case 'help.page.ckeditor_details':
      $output = '<h2>' . t('About') . '</h2>';
      $output .= '<p>' . t('Accordions are a popular way to structure content. This module adds a button so editors can easily use this element in their content.') . '</p>';
      $output .= '<p>' . t('Visit the <a href=":project_page">project page</a> for more details.', [':project_page' => 'https://www.drupal.org/project/ckeditor_details']) . '</p>';
      $output .= '<h2>' . t('Uses') . '</h2>';
      $output .= '<dl>';
      $output .= '<dt>' . t('Setting CKEditor-enabled text formats') . '</dt>';
      $output .= '<dd>' . t('Visit the <a href=":config_page">Text formats and editors</a> settings page and add the <em>Details</em> button to any CKEditor-enabled text format you want.', [':config_page' => Url::fromRoute('filter.admin_overview')->toString()]) . '</dd>';
      $output .= '</dt></dl>';
      return $output;
  }
  return NULL;
}
